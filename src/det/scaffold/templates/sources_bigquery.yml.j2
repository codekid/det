version: 2

sources:
  - name: {{ source_name }}
    config:
      enabled: "{{ '{{' }} target.name == 'bigquery' {{ '}}' }}"
    description: >
      BigLake Iceberg over DET bronze on gs:// (no second bronze copy).
      Requires DET_GCP_PROJECT and registered BigLake tables.
    database: "{{ '{{' }} env_var('DET_GCP_PROJECT') {{ '}}' }}"
    schema: {{ source_name }}
    tables:
{{ tables_yaml }}
