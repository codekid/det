{{ '{{' }}
    config(
        materialized="{{ silver_materialized }}",
        schema="silver_{{ provider }}"
{%- if silver_materialized == "incremental" %}
,
        unique_key={{ delete_key | tojson }},
        incremental_strategy='delete+insert' if target.name == 'bigquery' else '{{ incremental_strategy }}',
        tags=["det_catchup"]
{%- endif %}
{%- if bigquery and bigquery.has_layout() %}
,
        {{ '{% if target.name == \'bigquery\' %}' }}
{%- if bigquery.partition_by %}
        partition_by={{ bigquery.partition_by.to_dbt_dict() | tojson }},
{%- endif %}
{%- if bigquery.cluster_by %}
        cluster_by={{ bigquery.cluster_by | tojson }},
{%- endif %}
{%- if bigquery.require_partition_filter %}
        require_partition_filter=true,
{%- endif %}
        {{ '{% endif %}' }}
{%- endif %}
    )
{{ '}}' }}

-- generated by det scaffold-dbt; relation silver for {{ relation_name }}
with stg_filtered as (
    select *
    from {{ '{{' }} ref("stg_{{ model_slug }}") {{ '}}' }}
{%- if silver_materialized == "incremental" %}
    {{ '{{' }} det_silver_incremental_filter(
        watermark={{ watermark | tojson }},
        unique_key={{ delete_key | tojson }},
        pipeline_name={{ pipeline_name | tojson }},
        lookback={% if lookback %}{{ lookback | tojson }}{% else %}none{% endif %}
    ) {{ '}}' }}
{%- endif %}
),
{%- if silver_materialized == "incremental" %}
{{ '{{' }} det_silver_catchup_guard(
    watermark={{ watermark | tojson }},
    unique_key={{ delete_key | tojson }},
    pipeline_name={{ pipeline_name | tojson }}
) {{ '}}' }},
{%- else %}
base as (
    select * from stg_filtered
),
{%- endif %}
deduped as (
    {{ '{{' }} det_dedupe_latest_run(
        "base",
        partition_by={{ dedupe_key | tojson }},
        order_by={{ order_by | tojson }}
    ) {{ '}}' }}
)
select
    deduped.*,
    current_timestamp as __silver_processed_at,
    current_timestamp as __silver_updated_at
from deduped
