{{ '{{' }}
    config(
        materialized="{{ silver.materialized }}",
        schema="silver_{{ provider }}",
{%- if silver.materialized == "incremental" %}
        unique_key={{ silver.unique_key | tojson }},
        incremental_strategy="{{ silver.incremental_strategy }}",
{%- endif %}
    )
{{ '}}' }}

-- generated by det scaffold-dbt; silver identity/order from pipeline dbt.silver
with base as (
    select *
    from {{ '{{' }} ref("stg_{{ model_slug }}") {{ '}}' }}
{%- if silver.materialized == "incremental" %}
    {{ '{% if is_incremental() %}' }}
    where {{ silver.watermark }} {% if silver.lookback %}>= (
        select coalesce(
            max({{ silver.watermark }}) - interval '{{ silver.lookback }}',
            '0001-01-01'
        )
        from {{ '{{' }} this {{ '}}' }}
    ){% else %}> (
        select coalesce(max({{ silver.watermark }}), '0001-01-01')
        from {{ '{{' }} this {{ '}}' }}
    ){% endif %}
    {{ '{% endif %}' }}
{%- endif %}
),
deduped as (
    {{ '{{' }} det_dedupe_latest_run(
        "base",
        partition_by={{ silver.unique_key | tojson }},
        order_by={{ silver.order_by | tojson }}
    ) {{ '}}' }}
)
select
    deduped.*,
    current_timestamp as __silver_processed_at,
    current_timestamp as __silver_updated_at
from deduped
