with stg_filtered as (
    select *
    from {{ '{{' }} ref("stg_{{ model_slug }}") {{ '}}' }}
{%- if silver.materialized == "incremental" %}
    {{ '{{' }} det_silver_incremental_filter(
        watermark={{ silver.watermark | tojson }},
        unique_key={{ silver.unique_key | tojson }},
        pipeline_name={{ pipeline_name | tojson }},
        lookback={% if silver.lookback %}{{ silver.lookback | tojson }}{% else %}none{% endif %}
    ) {{ '}}' }}
{%- endif %}
),
{%- if silver.materialized == "incremental" %}
{{ '{{' }} det_silver_catchup_guard(
