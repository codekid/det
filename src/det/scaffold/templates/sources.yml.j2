version: 2

sources:
  - name: {{ source_name }}
    description: >
      DET bronze for provider feeds under this SQL schema / lake prefix.
      Tables set schema-aware read_json(... columns={...}) or iceberg_scan(...)
      in meta.external_location (DuckDB). On BigQuery, the same source name is a
      BigLake table ref (DET_GCP_PROJECT); DuckDB meta is Jinja-gated off.
      DuckDB native tables use det_bronze_from when DET_BRONZE_SOURCE=duckdb
      (set by det dbt --pipeline). Iceberg bronze uses iceberg_scan when
      DET_BRONZE_SOURCE=iceberg.
    schema: {{ source_name }}
    database: "{% raw %}{% if target.name == 'bigquery' %}{{ env_var('DET_GCP_PROJECT') }}{% endif %}{% endraw %}"
    tables:
{{ tables_yaml }}
