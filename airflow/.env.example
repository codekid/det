# Copy to airflow/.env (gitignored) and adjust as needed.
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Optional: Cursor/MCP agent → Airflow REST (defaults match this Compose stack).
# Override DET_AIRFLOW_BASE_URL for a remote Airflow later; Compose itself ignores these.
# DET_AIRFLOW_BASE_URL=http://localhost:8080
# DET_AIRFLOW_USER=airflow
# DET_AIRFLOW_PASSWORD=airflow
# DET_AIRFLOW_AUTH=basic
# DET_AIRFLOW_TIMEOUT_SEC=10

# Task logs: json (Compose default) so extract/load lines are greppable.
DET_LOG_FORMAT=json
# Optional lake lease TTL (seconds). Per-run override: dag_run.conf lock_ttl_sec.
# DET_LOCK_TTL_SEC=7200
# DET_LOCK=0  # unsafe: disable lake lease (tests only)

DET_PIPELINE_CONFIG=noaa.storm_events
DET_BRONZE_SOURCE=iceberg
DET_BRONZE_SCHEMA=bronze_noaa
DET_ANALYTICS_DUCKDB=/opt/det/data/analytics.duckdb
DET_OPS_DUCKDB=/opt/det/data/det_ops.duckdb

# Optional: narrow det_dbt_silver_gold dbt --select. Unset = entire dbt project
# (always excludes tag:ops; ops runs on det_ops_receipts).
# DET_DBT_SELECT=stg_noaa__storm_events+ stg_noaa__fatalities+

# Comma-separated dotted.key=value overrides (same as `det --set`).
# Leave empty for live NOAA. Uncomment for fixture-only runs (no network):
# DET_PIPELINE_OVERRIDES=source.overrides.local_csv_dir=fixtures/storm_events,source.overrides.filename_substr=details,ingestion.library=thin,destination.type=filesystem
DET_PIPELINE_OVERRIDES=

# Optional bronze prune (off by default)
# DET_PRUNE=1
# DET_PRUNE_APPLY=0
# DET_PRUNE_KEEP=1
